# =============================================
# Teach-Back Tutor — Backend Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Server ---
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated, optional - defaults allow all deployment URLs)
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=

# --- Google Gemini AI ---
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- MongoDB ---
# Option A: MongoDB Atlas (recommended — free tier available)
#   Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Option B: Local MongoDB
#   mongodb://localhost:27017/teach_back_tutor
#
# Leave blank to run in in-memory mode (sessions lost on restart).
MONGODB_URL=your_mongodb_connection_string_here

# Database name (default: teach_back_tutor)
DB_NAME=teach_back_tutor

# --- JWT Authentication ---
JWT_SECRET=your_jwt_secret_key_here
